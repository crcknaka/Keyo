<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required by the "set an alarm / timer" voice commands: stock clock apps enforce it on the
         caller of ACTION_SET_ALARM / ACTION_SET_TIMER. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Keyo is installed by hand, not from a store, so it offers its own updates from the
         project's GitHub releases. The system still shows its own install confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility for the "open <app>" voice command. A targeted <queries> filter replaces
         QUERY_ALL_PACKAGES, which is a restricted permission a keyboard has no case for. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup is OFF on purpose: the prefs hold the Groq API key and the clipboard history in
         plaintext, and Auto Backup would ship both to Drive and restore them onto any device.
         On Android 12+ that flag no longer covers device-to-device transfer on every OEM, so the
         extraction rules exclude the two preference files from that path explicitly as well. -->
    <application
        android:name=".KeyoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Keyo"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <service
            android:name=".KeyoService"
            android:label="Keyo"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Warms the Compose runtime in the fresh process right after each APK update, so the
             first keyboard show after an update doesn't pay first-composition costs inside the
             show-IME window transaction (slow layout there can leave a backgrounded app with a
             stuck "IME already visible" state and a keyboard that never appears). -->
        <receiver android:name=".PackageReplacedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- singleTop so the keyboard's "Edit ›" deep link reaches an already-open Settings task
             through onNewIntent instead of being dropped when the activity is merely brought forward. -->
        <activity
            android:name=".SettingsActivity"
            android:label="Keyo"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the downloaded APK to the system installer. A file:// URI is rejected outright on
             modern Android, so the update has to be shared through a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
